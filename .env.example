# INTELLIVEST-MAS configuration.
# Every value has a safe default; the system runs fully offline in deterministic mode.

# --- Reproducibility -------------------------------------------------------
INTELLIVEST_SEED=20261023

# --- Data window -----------------------------------------------------------
INTELLIVEST_DATA_START=2018-01-01
INTELLIVEST_DATA_END=2026-06-30
INTELLIVEST_LOOKBACK_DAYS=756
INTELLIVEST_RISK_FREE_RATE=0.065
INTELLIVEST_TRADING_DAYS=252

# --- Portfolio construction ------------------------------------------------
INTELLIVEST_MAX_WEIGHT=0.30
INTELLIVEST_MAX_SECTOR_WEIGHT=0.45
INTELLIVEST_TURNOVER_PENALTY=0.0020
INTELLIVEST_TRANSACTION_COST_BPS=12

# --- Black-Litterman view blending ----------------------------------------
INTELLIVEST_BL_TAU=0.05
INTELLIVEST_BL_VIEW_SHIFT=0.03
INTELLIVEST_BL_MAX_TOTAL_INFLUENCE=0.12

# --- LLM layer -------------------------------------------------------------
# deterministic | openai_compatible | mock
# "deterministic" keeps every number rule-based and offline. The optional
# OpenAI-compatible client may interpret the fact sheet and verbalise results,
# but it never chooses weights or supplies metrics.
INTELLIVEST_LLM_PROVIDER=deterministic
INTELLIVEST_LLM_MODEL=gpt-4o-mini
INTELLIVEST_LLM_BASE_URL=https://api.openai.com/v1
INTELLIVEST_LLM_API_KEY=
INTELLIVEST_LLM_TIMEOUT_S=30
